rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isParent(parentId) {
      return isSignedIn() && request.auth.uid == parentId;
    }

    // A kid device paired to this child: users/{parentId}/kidDevices/{the device's
    // anonymous UID} lists the children it may use (`childIds`). Written by the parent
    // app when pairing (claimPairingCode) or by onDeviceMigration for devices paired
    // before Oct 20, 2026.
    function isKid(parentId, childId) {
      let device = /databases/$(database)/documents/users/$(parentId)/kidDevices/$(request.auth.uid);
      return isSignedIn() && exists(device) && childId in get(device).data.get("childIds", []);
    }

    // ── Parent profile ────────────────────────────────────────

    match /users/{parentId} {
      allow read, write: if isParent(parentId);

      match /devices/{doc} {
        allow read, write: if isParent(parentId);
      }

      // Kid devices of this family (doc id = the device's anonymous UID): which
      // children may use it + "ask who's watching" timing. The parent manages them
      // (pair, change kids, unpair = delete); the device reads its own.
      match /kidDevices/{deviceUid} {
        allow read: if isParent(parentId) || (isSignedIn() && request.auth.uid == deviceUid);
        allow write: if isParent(parentId);
      }

      // Weekly digests live at parent level (not child level)
      match /digests/{date} {
        // Written by generateWeeklyDigest Cloud Function only
        allow read: if isParent(parentId);
        allow write: if false;
      }

      // ── Child profiles ───────────────────────────────────────

      match /children/{childId} {
        // Parent manages child profiles; a kid device paired to this child may read it
        allow read: if isParent(parentId) || isKid(parentId, childId);
        allow write: if isParent(parentId);

        // Content filter settings — path: valueFilters/current
        match /valueFilters/{doc} {
          // Parent app reads/writes; Cloud Functions use admin access
          allow read, write: if isParent(parentId);
        }

        // Whitelisted channels — kid app reads for subscription list
        match /whitelistedChannels/{channelId} {
          allow read: if isParent(parentId) || isKid(parentId, childId);
          // Only parent or Cloud Functions (resolveAndAddChannel) write
          allow write: if isParent(parentId);
        }

        // Per-child video verdicts — kid feed reads approved == true.
        // Written by Cloud Functions. The parent may only set or clear a
        // "Show anyway" decision, and `approved` must match the result.
        match /videoVerdicts/{videoId} {
          allow read: if isParent(parentId) || isKid(parentId, childId);
          allow update: if isParent(parentId)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(["parentDecision", "approved"])
            && (
              (request.resource.data.parentDecision in ["approved", "hidden"]
                && request.resource.data.approved == (request.resource.data.parentDecision == "approved"))
              || (!("parentDecision" in request.resource.data)
                && request.resource.data.approved == (resource.data.status == "approved"))
            );
          allow create, delete: if false;
        }

        // Watch history — COPPA 90-day retention
        match /watchHistory/{sessionId} {
          allow read: if isParent(parentId);
          // The paired kid device writes sessions; only start/end fields can change
          allow create: if isKid(parentId, childId);
          allow update: if isKid(parentId, childId)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(["endedAt", "durationSeconds"]);
          // Hard delete only via deleteChildData Cloud Function
          allow delete: if false;
        }

        // Flagged content — written by Cloud Functions during analysis
        match /flaggedContent/{flagId} {
          allow read: if isParent(parentId);
          allow update: if isParent(parentId)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(["parentViewed", "resolution"]);
          allow create, delete: if false;
        }

        // AI channel suggestions
        // "Not for us" on a suggested channel — never suggested to this child again
        match /dismissedSuggestions/{channelId} {
          allow read, write: if isParent(parentId);
        }

        match /suggestions/{suggestionId} {
          allow read: if isParent(parentId);
          allow update: if isParent(parentId)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(["parentResponse"]);
          allow create, delete: if false;
        }

        // Real-time session: nowPlaying (kid → parent) + parentCommand + playSignal
        match /currentSession/{doc} {
          // Parent and the paired kid device read this (live now-watching + commands)
          allow read: if isParent(parentId) || isKid(parentId, childId);

          // Kid device writes nowPlaying, parent app writes parentCommand,
          // playSignal is written by the handleParentCommand Cloud Function only
          allow write: if
            (doc == "nowPlaying"    && isKid(parentId, childId)) ||
            (doc == "parentCommand" && isParent(parentId));
        }
      }
    }

    // ── Pairing codes ─────────────────────────────────────────
    // The kid app (signed in anonymously) creates the code with its own UID; the
    // parent claims it once with their own UID (and writes kidDevices/{deviceUid}).
    match /pairingCodes/{code} {
      allow create: if isSignedIn()
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.claimed == false;
      allow read: if isSignedIn();
      allow update: if isSignedIn()
        && resource.data.claimed == false                 // one-time claim
        && request.resource.data.claimed == true
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.deviceUid == resource.data.deviceUid;
      allow delete: if false;
    }

    // ── Moving over devices paired before Oct 20, 2026 ────────
    // The kid app asks once ({parentId, childId} from its old session);
    // onDeviceMigration checks it and writes kidDevices/{uid} + a status here.
    match /deviceMigrations/{deviceUid} {
      allow create: if isSignedIn() && request.auth.uid == deviceUid
        && request.resource.data.keys().hasOnly(["parentId", "childId", "createdAt"])
        && request.resource.data.parentId is string
        && request.resource.data.childId is string;
      allow read: if isSignedIn() && request.auth.uid == deviceUid;
      allow update, delete: if false;
    }

    // ── Channel library cache ─────────────────────────────────
    // Kid app reads approved videos for its feed.
    // Written only by Cloud Functions (seed + refresh pipeline).
    match /channelLibraryCache/{channelId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /videos/{videoId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Shared AI analysis cache ──────────────────────────────
    // Shared across all users. Written only by Cloud Functions.
    match /videoAnalysisCache/{videoId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /results/{filterHash} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Video content profiles ────────────────────────────────
    // What a public YouTube video contains (summary, ratings) — no family data.
    // Parents read the summary for the now-watching card. Written by functions only;
    // valuesChecks (per-family rule results) stay server-only.
    match /videoProfiles/{videoId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // "Too hyper" reports: one per parent per video, counted by onPaceReport
    match /videoProfiles/{videoId}/paceReports/{parentId} {
      allow create, update: if isParent(parentId);
      allow read, delete: if false;
    }

    // ── Default deny ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
